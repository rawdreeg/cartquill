# Files and directories excluded from the built plugin package.
# Used by bin/build.sh and (if you prefer) `wp dist-archive`.
# Entries are literal paths relative to the plugin root — keep them simple so
# bin/build.sh can remove them from the staged package.

.git
.github
.gitignore
.distignore
# Directory-listing artwork (icon/banner/screenshots). Deployed to the SVN
# top-level assets/ dir by the release workflow — it is not part of the plugin.
.wordpress-org
.editorconfig
.phpunit.cache
tests
bin
composer.lock
phpunit.xml.dist
phpunit.xml
phpunit-integration.xml.dist
phpunit-9.phar
.wp-env.json
.wp-env.override.json
CLAUDE.md
build
dist
node_modules
package.json
package-lock.json
webpack.config.js

# OS / editor / agent cruft that must never ship. (Nested .DS_Store files are
# scrubbed recursively in bin/build.sh, since a literal path only strips the
# top-level one.)
.DS_Store
.claude
.omc

