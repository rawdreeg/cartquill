# Files and directories excluded from the built plugin package.
# Used by bin/build.sh and (if you prefer) `wp dist-archive`.
# Entries are literal paths relative to the plugin root — keep them simple so
# bin/build.sh can remove them from the staged package.

.git
.github
.gitignore
.distignore
# Directory-listing artwork (icon/banner/screenshots). Deployed to the SVN
# top-level assets/ dir by the release workflow — it is not part of the plugin.
.wordpress-org
.editorconfig
.phpunit.cache
tests
bin
composer.lock
phpunit.xml.dist
phpunit.xml
phpunit-integration.xml.dist
phpunit-9.phar
.wp-env.json
.wp-env.override.json
CLAUDE.md
build
dist
node_modules
package.json
package-lock.json
webpack.config.js

# OS / editor / agent cruft that must never ship. (Nested .DS_Store files are
# scrubbed recursively in bin/build.sh, since a literal path only strips the
# top-level one.)
.DS_Store
.claude
.omc

# Everything below this marker belongs to the separately distributed premium
# edition and is NOT part of core: the add-ons themselves, their admin screens
# and builder bundle, and the whole licensing/metering layer only premium uses.
#
# The core build strips all of it, so the plugin it produces contains no licence
# check, no plan, no usage cap and no upgrade prompt — every feature it ships is
# fully functional for every user. `bin/build.sh premium` keeps everything below
# the marker, assembled from this same tree.
# @cartquill:paid
src/Ai
src/Deliverability
src/Automations
src/Licensing
src/Metering/UsageMeter.php
src/Metering/UsageStore.php
src/Metering/WpdbUsageStore.php
src/Metering/InMemoryUsageStore.php
src/Admin/AiGeneratePage.php
src/Admin/DeliverabilityPage.php
src/Admin/LicensePage.php
src/Admin/UsageNotice.php
src/freemius.php
assets/builder/src/ai
