{
    "name": "cartquill/cartquill",
    "description": "Standalone WooCommerce email-automation plugin: proven flows, AI generation, revenue-per-flow reporting.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CartQuill\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CartQuill\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
